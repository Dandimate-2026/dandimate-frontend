# 비워두면 개발 서버는 배포 API로 프록시하고, 프로덕션 빌드는 아래 배포 주소를 사용합니다.
# 다른 백엔드를 쓸 때 호스트 또는 /api/v1까지 포함한 주소를 적으세요.
# https://43-201-73-60.sslip.io/api/v1
VITE_API_BASE_URL=

# 시안 데이터가 필요한 경우에만 true (기본값은 실제 API)
VITE_USE_MOCK=false

# 카카오톡 공유용 JavaScript 키 (카카오 developers > 앱 키). 비워두면 기기 공유창으로 대체
VITE_KAKAO_JS_KEY=

# 토스 테스트 결제 클라이언트 키 (test_ck_…). 백엔드 TOSS_SECRET_KEY와 같은 상점의 키여야 해요.
# 비워 두면 결제를 비활성화해요. 키 누락을 결제 성공으로 처리하지 않아요.
VITE_TOSS_CLIENT_KEY=

# 개발 중 결제 화면만 시연할 때 명시적으로 켜세요. 배포 빌드에는 적용되지 않아요.
VITE_PAYMENT_DEMO=false

# 친구에게 보내는 링크의 사이트 주소 (비우면 배포 주소)
VITE_SITE_URL=
